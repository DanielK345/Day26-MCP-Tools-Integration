# Tạo token mạnh, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=replace_with_a_long_random_token

# WeatherAPI.com key dùng bởi hai weather tools
WEATHER_API_KEY=your_weatherapi_key

# Optional
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PUBLIC_BASE_URL=http://localhost:8000
